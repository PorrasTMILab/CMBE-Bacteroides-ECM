# Assuming dfA_z and dfB_z are data.frames with species in 'Strain' column and z-scored numeric substrates

plot_pca <- function(df_z, title) {
  species <- df_z$Strain
  data_numeric <- df_z %>% select(-Strain)
  
  # Run PCA (no centering/scaling since data already z-scored)
  pca_res <- prcomp(data_numeric, center = FALSE, scale. = FALSE)
  
  # Variance explained
  var_explained <- round(100 * (pca_res$sdev^2 / sum(pca_res$sdev^2)), 1)
  
  # Scores for PC1 and PC2
  scores <- as.data.frame(pca_res$x[, 1:5])
  scores$Strain <- species
  
  # Loadings
  loadings <- as.data.frame(pca_res$rotation[, 1:5])
  loadings$Substrate <- rownames(loadings)
  
  # Scatter plot PC1 vs PC2 with species labels
  gg <- ggplot(scores, aes(x = PC1, y = PC2, label = Strain)) +
    geom_point(color = "steelblue", size = 3) +
    geom_text_repel(max.overlaps = 20) +
    labs(
      title = paste(title, "PCA: PC1 vs PC2"),
      x = paste0("PC1 (", var_explained[1], "% variance)"),
      y = paste0("PC2 (", var_explained[2], "% variance)")
    ) +
    theme_minimal()
  
  list(plot = gg, variance_explained = var_explained[1:5], loadings = loadings)
}

# Plot and save PCA for computational matrix
